{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reel_factory.reference_video_remix_plan.v1",
  "title": "Historical Reference Video Remix Plan",
  "description": "Read-only compatibility for historical remix evidence. This schema cannot authorize current execution.",
  "type": "object",
  "required": [
    "schema",
    "planId",
    "status",
    "reference",
    "scope",
    "identity",
    "framePair",
    "animation",
    "lineageSeed",
    "qualityGates",
    "approval"
  ],
  "properties": {
    "schema": {"const": "reel_factory.reference_video_remix_plan.v1"},
    "planId": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "reference": {"type": "object"},
    "scope": {"type": "object"},
    "identity": {"type": "object"},
    "framePair": {"type": "object"},
    "animation": {
      "type": "object",
      "required": ["paidGenerationAuthorized"],
      "properties": {
        "paidGenerationAuthorized": {"const": false}
      }
    },
    "lineageSeed": {"type": "object"},
    "qualityGates": {"type": "object"},
    "approval": {
      "type": "object",
      "required": ["publishingAllowed"],
      "properties": {
        "publishingAllowed": {"const": false}
      }
    }
  }
}
