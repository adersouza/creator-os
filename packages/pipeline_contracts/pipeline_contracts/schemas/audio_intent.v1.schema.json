          "type": [
            "string",
            "null"
          ]
        },
        "territory": {
          "type": [
            "string",
            "null"
          ]
        },
        "accountScope": {
          "type": [
            "string",
            "null"
          ]
        },
        "commercialUseAllowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidenceReceipt": {
          "type": [
            "string",
            "object",
            "null"
          ]
        }
      }
    },
    "performance_learning": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "canonical_track_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform_sound_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
