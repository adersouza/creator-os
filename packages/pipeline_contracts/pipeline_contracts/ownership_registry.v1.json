  "invariants": [
    "one_canonical_owner_per_runtime_fact",
    "cross_system_ids_are_join_keys_not_shared_write_authority",
    "creator_os_never_writes_dashboard_schedule_or_publication_tables",
    "threadsdashboard_never_writes_creator_os_generation_or_approval_state",
    "cross_system_mutations_use_the_owning_api",
    "delivery_media_is_bound_to_the_approved_final_sha",
    "imported_observations_preserve_upstream_identity_and_fingerprint",
