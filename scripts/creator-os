def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="creator-os",
        description="Operate Creator OS through one explicit, headless command surface.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser(
        "status", help="read-only live configuration/runtime status"
    )
    status.add_argument("--json", action="store_true")
    status_scope = status.add_mutually_exclusive_group()
    status_scope.add_argument("--creator")
    status_scope.add_argument("--campaign")
    status_scope.add_argument("--generation")
    status_scope.add_argument("--publication")
    status_scope.add_argument("--learning", action="store_true")
    status.add_argument(
        "--live-read-only",
        action="store_true",
        help="run configured zero-write network/provider probes",
    )

    sources = sub.add_parser(
        "sources",
        help="inspect or explicitly approve creator-bound source inventory",
    )
    source_commands = sources.add_subparsers(dest="source_command", required=True)
    source_list = source_commands.add_parser("list")
    source_list.add_argument("--creator", required=True)
    for action in ("approve", "reject"):
        source_decision = source_commands.add_parser(action)
        source_decision.add_argument("--creator", required=True)
        source_decision.add_argument(
            "--source", required=True, help="exact source ID, SHA-256, or path"
        )
        source_decision.add_argument("--operator", required=True)
        source_decision.add_argument("--reason", required=True)
        source_decision.add_argument("--apply", action="store_true")

    media = sub.add_parser(
        "media",
        help="reconcile fully attributable existing Creator OS media",
    )
    media_sub = media.add_subparsers(dest="media_action", required=True)
    intake_existing = media_sub.add_parser("intake-existing")
    intake_existing.add_argument("--manifest", type=Path, required=True)
    intake_mode = intake_existing.add_mutually_exclusive_group(required=True)
    intake_mode.add_argument("--dry-run", action="store_true")
    intake_mode.add_argument("--apply", action="store_true")
    review_existing = media_sub.add_parser("review-existing")
    review_existing.add_argument("--asset", required=True)
    review_existing.add_argument("--final-sha", required=True)
    review_existing.add_argument("--reviewer", required=True)
    review_existing.add_argument(
        "--verdict",
        choices=["WOULD_POST", "USABLE_AFTER_EDIT", "REJECT"],
        required=True,
    )
    for field in ("identity", "anatomy", "motion", "phone-native", "audio-fit"):
        review_existing.add_argument(f"--{field}")
    review_existing.add_argument("--notes")
    review_mode = review_existing.add_mutually_exclusive_group(required=True)
    review_mode.add_argument("--dry-run", action="store_true")
    review_mode.add_argument("--apply", action="store_true")

    plan = sub.add_parser(
        "plan",
        help="build or operate one supervised rolling creator content plan",
    )
    plan_sub = plan.add_subparsers(dest="plan_action")
    plan.add_argument("--creator")
    plan.add_argument("--horizon", default="7d")
    plan.add_argument("--accounts")
    plan.add_argument(
        "--goal",
        choices=[
            "growth",
            "consistency",
            "engagement",
            "profile_curiosity",
            "content_testing",
            "winner_expansion",
            "warming",
            "maintenance",
        ],
        default="growth",
    )
    plan.add_argument("--count", type=int)
    plan.add_argument("--timezone", default="America/New_York")
    plan.add_argument(
        "--mode",
        choices=["shadow", "supervised", "approved_plan_autopilot"],
        default="supervised",
    )
    plan.add_argument("--max-credits", type=float)
    plan.add_argument("--start-date")
    plan_mode = plan.add_mutually_exclusive_group()
    plan_mode.add_argument("--dry-run", action="store_true")
    plan_mode.add_argument("--apply", action="store_true")
    plan_show = plan_sub.add_parser("show")
    plan_show.add_argument("plan_id")
    plan_list = plan_sub.add_parser("list")
    plan_list.add_argument("--creator")
    plan_list.add_argument("--limit", type=int, default=50)
    plan_approve = plan_sub.add_parser("approve")
    plan_approve.add_argument("plan_id")
    plan_approve.add_argument("--operator", default="authenticated_local_operator")
    plan_approve.add_argument("--reason", default="operator_approved_plan")
    plan_schedule = plan_sub.add_parser("schedule-propose")
    plan_schedule.add_argument("plan_id")
    plan_schedule.add_argument("--blackout-date", action="append", default=[])
    plan_schedule_mode = plan_schedule.add_mutually_exclusive_group(required=True)
    plan_schedule_mode.add_argument("--dry-run", action="store_true")
    plan_schedule_mode.add_argument("--apply", action="store_true")
    plan_experiment = plan_sub.add_parser("experiment")
    plan_experiment.add_argument("plan_id")
    plan_experiment.add_argument("--variable", required=True)
    plan_experiment.add_argument("--variant", action="append", required=True)
    plan_experiment.add_argument("--hypothesis", required=True)
    plan_experiment_mode = plan_experiment.add_mutually_exclusive_group(required=True)
    plan_experiment_mode.add_argument("--dry-run", action="store_true")
    plan_experiment_mode.add_argument("--apply", action="store_true")
    plan_execute = plan_sub.add_parser("execute")
    plan_execute.add_argument("plan_id")
    plan_execute.add_argument("--max-credits", type=float)
    plan_execute_mode = plan_execute.add_mutually_exclusive_group(required=True)
    plan_execute_mode.add_argument("--dry-run", action="store_true")
    plan_execute_mode.add_argument("--apply", action="store_true")
    plan_review = plan_sub.add_parser("review")
    plan_review.add_argument("plan_id")
    plan_review.add_argument("--item")
    plan_review.add_argument("--action")
    plan_review.add_argument("--operator", default="authenticated_local_operator")
    plan_review.add_argument("--reason")
    plan_export = plan_sub.add_parser("export")
    plan_export.add_argument("plan_id")
    plan_export.add_argument("--approved-only", action="store_true")
    plan_status = plan_sub.add_parser("status")
    plan_status.add_argument("plan_id")
    plan_replan = plan_sub.add_parser("replan")
    plan_replan.add_argument("plan_id")
    plan_replan_mode = plan_replan.add_mutually_exclusive_group(required=True)
    plan_replan_mode.add_argument("--dry-run", action="store_true")
    plan_replan_mode.add_argument("--apply", action="store_true")
    plan_attach = plan_sub.add_parser("attach-existing")
    plan_attach.add_argument("plan_id")
    plan_attach.add_argument("--item", required=True)
    plan_attach.add_argument("--asset", required=True)
    plan_attach_mode = plan_attach.add_mutually_exclusive_group(required=True)
    plan_attach_mode.add_argument("--dry-run", action="store_true")
    plan_attach_mode.add_argument("--apply", action="store_true")

    doctor = sub.add_parser("doctor", help="read-only fixture-backed integrity audit")
    doctor.add_argument("args", nargs=argparse.REMAINDER)

    sync = sub.add_parser(
        "performance-sync",
        help="preview or apply the pinned ThreadsDashboard metrics/learning sync",
    )
    sync_mode = sync.add_mutually_exclusive_group(required=True)
    sync_mode.add_argument("--dry-run", action="store_true")
    sync_mode.add_argument("--apply", action="store_true")

    learning_refresh = sub.add_parser(
        "learning-refresh",
        help="preview or apply the versioned Reference-to-Campaign learning refresh",
    )
    learning_refresh_mode = learning_refresh.add_mutually_exclusive_group(required=True)
    learning_refresh_mode.add_argument("--dry-run", action="store_true")
    learning_refresh_mode.add_argument("--apply", action="store_true")

    learning_review = sub.add_parser(
        "learning-review",
        help="inspect or explicitly approve, reject, pin, or revoke recommendations",
    )
    learning_review.add_argument(
        "action", choices=["list", "approve", "reject", "pin", "revoke"]
    )
    learning_review.add_argument("--id")
    learning_review.add_argument("--operator")
    learning_review.add_argument("--reason")

    reference_refresh = sub.add_parser(
        "reference-refresh",
        help="preview or apply the local reference/audio refresh workflow",
    )
    reference_mode = reference_refresh.add_mutually_exclusive_group(required=True)
    reference_mode.add_argument("--dry-run", action="store_true")
    reference_mode.add_argument("--apply", action="store_true")
    reference_refresh.add_argument(
        "--source", type=Path, default=Path.home() / "Downloads/tiktok"
    )
    reference_refresh.add_argument(
        "--audio-export",
        type=Path,
        default=ROOT.parent / "reference_reels/audio_catalog.json",
    )

    audio = sub.add_parser(
        "audio",
        help="operate the private Audio Radar discovery and cache library",
    )
    audio_commands = audio.add_subparsers(dest="audio_command", required=True)
    audio_refresh = audio_commands.add_parser(
        "refresh",
        help="run the bounded weekly live audio-library refresh",
    )
    audio_refresh.add_argument("--region", default="US")
    audio_refresh.add_argument("--max-new", type=int, default=20)
    audio_refresh.add_argument("--max-active", type=int, default=75)
    audio_refresh_mode = audio_refresh.add_mutually_exclusive_group(required=True)
    audio_refresh_mode.add_argument("--dry-run", action="store_true")
    audio_refresh_mode.add_argument("--apply", action="store_true")
    audio_status_parser = audio_commands.add_parser(
        "status", help="summarize the canonical active audio library read-only"
    )
    audio_status_parser.add_argument("--json", action="store_true")

    create = sub.add_parser(
        "create",
        help="create a production batch from creator intent; dry-run unless --apply",
    )
    create.add_argument("--creator", required=True)
    create.add_argument(
        "--intent",
        required=True,
        choices=[
            "passive_selfie",
            "flirty_portrait",
            "outfit",
            "lifestyle",
            "animate_existing",
            "motion_copy",
            "dance",
            "talking_selfie",
            "talking_motion_copy",
        ],
    )
    create.add_argument("--count", type=int, default=1)
    create.add_argument("--execution", choices=["cloud"], default="cloud")
    create.add_argument("--max-credits", type=float)
    create.add_argument("--concurrency", type=int)
    create.add_argument("--accounts")
    create.add_argument("--speech-audio", type=Path)
    create.add_argument("--motion-reference", type=Path)
    create.add_argument(
        "--audio",
        dest="audio_preference",
        choices=[
            "embedded_trending",
            "embedded_trending_required",
            "native_trending_required",
            "original_embedded",
            "creator_voice",
            "royalty_free",
            "silent_allowed",
        ],
        default="embedded_trending_required",
    )
    create.add_argument("--apply", action="store_true")

    video_bakeoff = sub.add_parser(
        "video-bakeoff",
        help=(
            "inspect historical provider bakeoff evidence; never schedules or publishes"
        ),
    )
    video_bakeoff.add_argument("args", nargs=argparse.REMAINDER)

    generate = sub.add_parser(
        "generate",
        help="advanced explicit-mode generation compatibility surface",
    )
    generation_choice = generate.add_mutually_exclusive_group(required=True)
    generation_choice.add_argument("--mode")
    generation_choice.add_argument("--list-modes", action="store_true")
    generation_execution = generate.add_mutually_exclusive_group()
    generation_execution.add_argument("--dry-run", action="store_true")
    generation_execution.add_argument("--apply", action="store_true")
    generate.add_argument("--campaign")
    generate.add_argument("--reference-image", type=Path)
    generate.add_argument("--accepted-still", type=Path)
    generate.add_argument("--kling-selection-receipt", type=Path)
    generate.add_argument("--reference-video", type=Path)
    generate.add_argument("--target", help="creator identity/name")
    generate.add_argument("--soul-id")
    generate.add_argument("--workspace", type=Path)
    generate.add_argument("--confirm-paid", action="store_true")
    generate.add_argument("--max-credits", type=float)
    generate.add_argument("--max-usd", type=float)
    generate.add_argument("--caption")
    generate.add_argument("--duration", type=float)
    generate.add_argument("--motion-model")
    generate.add_argument("--local-evidence-bundle", type=Path)
    generate.add_argument("--local-arena-summary", type=Path)
    generate.add_argument("--router-override-operator")
    generate.add_argument("--router-override-reason")
    generate.add_argument(
        "--motion-task",
        choices=[
            "text_to_video",
            "image_to_video",
            "audio_image_to_video",
            "motion_control",
            "video_lipsync",
            "keyframe_interpolation",
            "video_retake",
            "video_extend",
        ],
        default="image_to_video",
    )
    generate.add_argument("--motion-prompt")
    generate.add_argument("--audio", type=Path)
    generate.add_argument("--generate-audio", action="store_true")
    generate.add_argument(
        "--audio-policy",
        choices=[
            "embedded_trending_required",
            "native_trending_required",
            "original_embedded",
            "creator_voice",
            "royalty_free",
            "silent_allowed",
        ],
        default="embedded_trending_required",
    )
    generate.add_argument("--audio-track-id")
    generate.add_argument("--audio-track-name")
    generate.add_argument("--audio-source")
    generate.add_argument("--audio-start-offset", type=float)
    generate.add_argument("--audio-volume", type=float)
    generate.add_argument("--audio-selected-reason")
    generate.add_argument("--last-image", type=Path)
    generate.add_argument("--source-video", type=Path)
    generate.add_argument("--retake-start-frame", type=int)
    generate.add_argument("--retake-end-frame", type=int)
    generate.add_argument("--extend-frames", type=int)
    generate.add_argument(
        "--extend-direction", choices=["before", "after"], default="after"
    )
    generate.add_argument("--preserve-audio", action="store_true")
    generate.add_argument(
        "--motion-reference-image", type=Path, action="append", default=[]
    )
    generate.add_argument(
        "--motion-reference-video", type=Path, action="append", default=[]
    )
    generate.add_argument("--resolution")
    generate.add_argument("--seed", type=int, default=42)
    generate.add_argument("--steps", type=int)
    generate.add_argument("--enable-prompt-expansion", action="store_true")
    generate.add_argument("--shot-type", choices=["single", "multi"], default="single")
    generate.add_argument(
        "--local-model-dir", "--local-wan-model-dir", dest="local_model_dir", type=Path
    )
    generate.add_argument("--motion-lora", type=Path)
    generate.add_argument("--motion-lora-strength", type=float, default=1.0)
    generate.add_argument("--count", type=int, default=3)
    generate.add_argument("--account")
    generate.add_argument("--folder", type=Path)
    generate.add_argument("--model")
    generate.add_argument(
        "--format", choices=["reel", "slideshow", "auto"], default="auto"
    )
    generate.add_argument("--variant-count", type=int, default=20)
    generate.add_argument("--workers", type=int, default=3)
    generate.add_argument("--first-frame-approval-id")
    generate.add_argument("--last-frame-approval-id")
    generate.add_argument("--operator-selected", action="store_true")
    generate.add_argument("--rights-confirmed", action="store_true")
    generate.add_argument(
        "--preferred-provider", choices=["auto", "seedance", "kling"], default="auto"
    )
    generate.add_argument(
        "--available-provider",
        choices=["seedance", "kling"],
        action="append",
        default=[],
    )
    generate.add_argument("--allow-upscale", action="store_true")
    generate.add_argument("--wait", action="store_true")
    generate.add_argument("--download", action="store_true")

    review = sub.add_parser(
        "review",
        aliases=["readiness"],
        help="ordinary read-only Campaign creative/QC review",
    )
    review.add_argument("--campaign", required=True)
    review.add_argument("--user-id")

    approve = sub.add_parser(
        "approve",
        help="build and sign one immutable v2 approval from an exact review draft",
    )
    approve.add_argument("--campaign", required=True)
    approve.add_argument("--rendered-asset-id", required=True)
    approve.add_argument("--user-id", required=True)
    approve.add_argument("--approved-by", required=True)
    approve.add_argument("--root", type=Path)
    approve.add_argument(
        "--surface",
        choices=[
            "regular_reel",
            "trial_reel",
            "story",
            "story_cta",
            "feed_single",
            "feed_carousel",
        ],
        default="regular_reel",
    )
    approve.add_argument("--publish-mode", choices=["auto", "notify"])

    draft = sub.add_parser(
        "export",
        aliases=["draft-export"],
        help="preview or explicitly write validated drafts; never schedules or publishes",
    )
    draft_mode = draft.add_mutually_exclusive_group(required=True)
    draft_mode.add_argument("--dry-run", action="store_true")
    draft_mode.add_argument("--apply", action="store_true")
    draft.add_argument("--campaign", required=True)
    draft.add_argument("--user-id", required=True)
    draft.add_argument("--max-drafts", type=int, required=True)
    draft.add_argument("--rendered-asset-id", action="append", default=[])
    draft.add_argument(
        "--surface",
        choices=[
            "regular_reel",
            "trial_reel",
            "story",
            "story_cta",
            "feed_single",
            "feed_carousel",
        ],
        default="regular_reel",
        help="Export one explicit distribution surface (default: regular_reel)",
    )
    draft.add_argument("--review-only", action="store_true")

    advanced = sub.add_parser(
        "advanced",
        help="developer diagnostics for local models, queue, benchmarks, and analyzers",
    )
    advanced.add_argument(
        "surface",
        choices=[
            "models",
            "queue",
            "benchmarks",
            "arena",
            "identity",
            "router",
            "analyzers",
            "evidence-key",
            "approval-import",
            "motion-qc-register",
            "prompt-expander",
        ],
    )
    advanced.add_argument("args", nargs=argparse.REMAINDER)

    promote = sub.add_parser(
        "promote",
        help="guardedly promote one reviewed commit into creator-os-runtime",
    )
    promote.add_argument("--source-root", type=Path, default=ROOT)
    promote.add_argument(
        "--runtime-root",
        type=Path,
        required=True,
        help="exact clean runtime checkout; never inferred from a worktree",
    )
    promote.add_argument("--approved-commit", required=True)
    promote.add_argument("--approval", type=Path, required=True)
    promote.add_argument(
        "--state-root",
        type=Path,
        default=Path.home() / ".creator-os/state/runtime_promotions",
    )
    promote.add_argument("--operator", required=True)
    promote.add_argument("--dry-run", action="store_true")

    return parser


def main(argv: list[str] | None = None) -> int:
    effective_argv = list(sys.argv[1:] if argv is None else argv)
    compatibility_surfaces = {
        "local-models": "models",
        "local-queue": "queue",
        "local-benchmarks": "benchmarks",
        "approve-import": "approval-import",
        "motion-qc-register": "motion-qc-register",
    }
    if effective_argv and effective_argv[0] in compatibility_surfaces:
        legacy = effective_argv[0]
        surface = compatibility_surfaces[legacy]
        print(
            f"deprecated: use `creator-os advanced {surface}`; compatibility retained",
            file=sys.stderr,
        )
        effective_argv = ["advanced", surface, *effective_argv[1:]]
    args = _parser().parse_args(effective_argv)
    if args.command == "status":
        status_filters = [
            ("--creator", args.creator),
            ("--campaign", args.campaign),
            ("--generation", args.generation),
            ("--publication", args.publication),
        ]
        selected = next(
            ((flag, value) for flag, value in status_filters if value), None
        )
        if selected or args.learning:
            command = _operator_status_command(
                *(selected if selected else ("--learning",))
            )
            if args.json:
                command.append("--json")
            return _run(command)
        command = _doctor_command("--status")
        if args.json:
            command.append("--json")
        if args.live_read_only:
            command.append("--live-read-only")
        return _run(command)
    if args.command == "doctor":
        doctor_args = args.args[1:] if args.args[:1] == ["--"] else args.args
        return _run(_doctor_command(*doctor_args))
    if args.command == "sources":
        command = _source_command(args.source_command, "--creator", args.creator)
        if args.source_command != "list":
            command.extend(
                [
                    "--source",
                    args.source,
                    "--operator",
                    args.operator,
                    "--reason",
                    args.reason,
                ]
            )
            if args.apply:
                command.append("--apply")
        return _run(command)
    if args.command == "media":
        if args.media_action == "intake-existing":
            return _run(
                _existing_media_command(
                    "intake",
                    "--manifest",
                    str(args.manifest.expanduser().resolve()),
                    "--apply" if args.apply else "--dry-run",
                )
            )
        command = _existing_media_command(
            "review",
            "--asset",
            args.asset,
            "--final-sha",
            args.final_sha,
            "--reviewer",
            args.reviewer,
            "--verdict",
            args.verdict,
            "--apply" if args.apply else "--dry-run",
        )
        for flag, value in (
            ("--identity", args.identity),
            ("--anatomy", args.anatomy),
            ("--motion", args.motion),
            ("--phone-native", args.phone_native),
            ("--audio-fit", args.audio_fit),
            ("--notes", args.notes),
        ):
            if value:
                command.extend([flag, value])
        return _run(command)
    if args.command == "plan":
        if args.plan_action == "show":
            return _run(_content_director_command("show", args.plan_id))
        if args.plan_action == "list":
            command = _content_director_command("list", "--limit", str(args.limit))
            if args.creator:
                command.extend(["--creator", args.creator])
            return _run(command)
        if args.plan_action == "approve":
            return _run(
                _content_director_command(
                    "approve",
                    args.plan_id,
                    "--operator",
                    args.operator,
                    "--reason",
                    args.reason,
                )
            )
        if args.plan_action == "schedule-propose":
            command = _content_director_command(
                "schedule-propose",
                args.plan_id,
                "--apply" if args.apply else "--dry-run",
            )
            for value in args.blackout_date:
                command.extend(["--blackout-date", value])
            return _run(command)
        if args.plan_action == "experiment":
            command = _content_director_command(
                "experiment",
                args.plan_id,
                "--variable",
                args.variable,
                "--hypothesis",
                args.hypothesis,
                "--apply" if args.apply else "--dry-run",
            )
            for value in args.variant:
                command.extend(["--variant", value])
            return _run(command)
        if args.plan_action == "execute":
            command = _content_director_command(
                "execute",
                args.plan_id,
                "--apply" if args.apply else "--dry-run",
            )
            if args.max_credits is not None:
                command.extend(["--max-credits", str(args.max_credits)])
            return _run(command)
        if args.plan_action == "review":
            command = _content_director_command("review", args.plan_id)
            for flag, value in (
                ("--item", args.item),
                ("--action", args.action),
                ("--operator", args.operator),
                ("--reason", args.reason),
            ):
                if value is not None:
                    command.extend([flag, value])
            return _run(command)
        if args.plan_action == "export":
            command = _content_director_command("export", args.plan_id)
            if args.approved_only:
                command.append("--approved-only")
            return _run(command)
        if args.plan_action == "status":
            return _run(_content_director_command("status", args.plan_id))
        if args.plan_action == "replan":
            return _run(
                _content_director_command(
                    "replan",
                    args.plan_id,
                    "--apply" if args.apply else "--dry-run",
                )
            )
        if args.plan_action == "attach-existing":
            return _run(
                _existing_media_command(
                    "attach",
                    "--plan",
                    args.plan_id,
                    "--item",
                    args.item,
                    "--asset",
                    args.asset,
                    "--apply" if args.apply else "--dry-run",
                )
            )
        if not args.creator or not args.accounts:
            print("plan requires --creator and --accounts", file=sys.stderr)
            return 2
        if args.dry_run == args.apply:
            print("plan requires exactly one of --dry-run or --apply", file=sys.stderr)
            return 2
        command = _content_director_command(
            "build",
            "--creator",
            args.creator,
            "--horizon",
            args.horizon,
            "--accounts",
            args.accounts,
            "--goal",
            args.goal,
            "--timezone",
            args.timezone,
            "--mode",
            args.mode,
            "--apply" if args.apply else "--dry-run",
        )
        for flag, value in (
            ("--count", args.count),
            ("--max-credits", args.max_credits),
            ("--start-date", args.start_date),
        ):
            if value is not None:
                command.extend([flag, str(value)])
        return _run(command)
    if args.command == "performance-sync":
        command = [str(ROOT / "scripts/run_threadsdash_performance_sync.sh")]
        if args.dry_run:
            command.append("--dry-run")
        return _run(command)
    if args.command == "learning-refresh":
        return _run(
            _learning_command(
                "refresh", "--apply" if args.apply else "--dry-run"
            )
        )
    if args.command == "learning-review":
        command = _learning_command("review", args.action)
        for flag, value in (
            ("--id", args.id),
            ("--operator", args.operator),
            ("--reason", args.reason),
        ):
            if value:
                command.extend([flag, value])
        return _run(command)
    if args.command == "reference-refresh":
        source = args.source.expanduser().resolve()
        audio_export = args.audio_export.expanduser().resolve()
        commands = [
            _reference_command("import-tiktok-archive", "--source", str(source)),
            _reference_command("refresh-tiktok-audio", "--source", str(source)),
            _reference_command("analyze-audio-patterns"),
            _reference_command("audio-health"),
            _reference_command("list-audio", "--export", str(audio_export)),
            _campaign_command("import-audio-catalog", "--path", str(audio_export)),
        ]
        if args.dry_run:
            for command in commands:
                print(" ".join(command))
            return 0
        for command in commands:
            if code := _run(command):
                return code
        return 0
    if args.command == "audio":
        if args.audio_command == "status":
            command = _operator_status_command("--audio")
            if args.json:
                command.append("--json")
            return _run(command)
        if args.audio_command != "refresh":
            raise AssertionError(f"unhandled audio command: {args.audio_command}")
        return _run(
            _audio_command(
                "refresh",
                "--region",
                args.region,
                "--max-new",
                str(args.max_new),
                "--max-active",
                str(args.max_active),
                "--apply" if args.apply else "--dry-run",
            )
        )
    if args.command == "create":
        if args.count <= 0:
            print("--count must be greater than zero", file=sys.stderr)
            return 2
        command = _campaign_command(
            "create",
            "--creator",
            args.creator,
            "--intent",
            args.intent,
            "--count",
            str(args.count),
            "--execution",
            args.execution,
            "--audio",
            args.audio_preference,
        )
        if args.accounts:
            command.extend(["--accounts", args.accounts])
        if args.speech_audio:
            command.extend(["--speech-audio", str(args.speech_audio)])
        if args.motion_reference:
            command.extend(["--motion-reference", str(args.motion_reference)])
        if args.max_credits is not None:
            if not math.isfinite(args.max_credits) or args.max_credits <= 0:
                print(
                    "--max-credits must be finite and greater than zero",
                    file=sys.stderr,
                )
                return 2
            command.extend(["--max-credits", str(args.max_credits)])
        if args.concurrency is not None:
            if not 1 <= args.concurrency <= 4:
                print("--concurrency must be between 1 and 4", file=sys.stderr)
                return 2
            command.extend(["--concurrency", str(args.concurrency)])
        if args.apply:
            command.append("--apply")
        return _run(command)
    if args.command == "video-bakeoff":
        bakeoff_args = args.args[1:] if args.args[:1] == ["--"] else args.args
        return _run(_higgsfield_bakeoff_command(*bakeoff_args))
    if args.command == "generate":
        print(
            "deprecated advanced compatibility command: ordinary production uses "
            "`creator-os create`",
            file=sys.stderr,
        )
        if args.list_modes:
            return _run(_campaign_command("generation", "modes"))
        if not args.campaign:
            print("create requires --campaign", file=sys.stderr)
            return 2
        if args.dry_run == args.apply:
            print(
                "create requires exactly one of --dry-run or --apply", file=sys.stderr
            )
            return 2
        if args.max_credits is not None and (
            not math.isfinite(args.max_credits) or args.max_credits <= 0
        ):
            print("--max-credits must be finite and greater than zero", file=sys.stderr)
            return 2
        if args.max_usd is not None and (
            not math.isfinite(args.max_usd) or args.max_usd <= 0
        ):
            print("--max-usd must be finite and greater than zero", file=sys.stderr)
            return 2
        if args.duration is not None and (
            not math.isfinite(args.duration) or args.duration <= 0
        ):
            print("--duration must be finite and greater than zero", file=sys.stderr)
            return 2
        if args.count <= 0 or args.variant_count <= 0 or args.workers <= 0:
            print(
                "--count, --variant-count, and --workers must be greater than zero",
                file=sys.stderr,
            )
            return 2
        command = _campaign_command(
            "generation",
            "run",
            "--mode",
            args.mode,
            "--campaign",
            args.campaign,
            "--apply" if args.apply else "--dry-run",
        )
        optional_paths = (
            ("--reference-image", args.reference_image),
            ("--accepted-still", args.accepted_still),
            ("--kling-selection-receipt", args.kling_selection_receipt),
            ("--reference-video", args.reference_video),
            ("--workspace", args.workspace),
            ("--folder", args.folder),
            ("--audio", args.audio),
            ("--last-image", args.last_image),
            ("--source-video", args.source_video),
            ("--local-model-dir", args.local_model_dir),
            ("--local-evidence-bundle", args.local_evidence_bundle),
            ("--local-arena-summary", args.local_arena_summary),
        )
        for flag, value in optional_paths:
            if value is not None:
                command.extend([flag, str(value.expanduser().resolve())])
        optional_values = (
            ("--target", args.target),
            ("--soul-id", args.soul_id),
            ("--max-credits", args.max_credits),
            ("--max-usd", args.max_usd),
            ("--caption", args.caption),
            ("--duration", args.duration),
            ("--account", args.account),
            ("--first-frame-approval-id", args.first_frame_approval_id),
            ("--last-frame-approval-id", args.last_frame_approval_id),
            ("--motion-model", args.motion_model),
            ("--router-override-operator", args.router_override_operator),
            ("--router-override-reason", args.router_override_reason),
            ("--motion-task", args.motion_task),
            ("--motion-prompt", args.motion_prompt),
            ("--audio-policy", args.audio_policy),
            ("--audio-track-id", args.audio_track_id),
            ("--audio-track-name", args.audio_track_name),
            ("--audio-source", args.audio_source),
            ("--audio-start-offset", args.audio_start_offset),
            ("--audio-volume", args.audio_volume),
            ("--audio-selected-reason", args.audio_selected_reason),
            ("--resolution", args.resolution),
            ("--seed", args.seed),
            ("--steps", args.steps),
            ("--shot-type", args.shot_type),
            ("--motion-lora-strength", args.motion_lora_strength),
            ("--retake-start-frame", args.retake_start_frame),
            ("--retake-end-frame", args.retake_end_frame),
            ("--extend-frames", args.extend_frames),
            ("--extend-direction", args.extend_direction),
        )
        for flag, value in optional_values:
            if value is not None:
                command.extend([flag, str(value)])
        command.extend(["--count", str(args.count)])
        command.extend(["--variant-count", str(args.variant_count)])
        command.extend(["--workers", str(args.workers)])
        command.extend(["--format", args.format])
        if args.model:
            command.extend(["--model", args.model])
        if args.preserve_audio:
            command.append("--preserve-audio")
        command.extend(["--preferred-provider", args.preferred_provider])
        for provider in args.available_provider:
            command.extend(["--available-provider", provider])
        for path in args.motion_reference_image:
            command.extend(
                ["--motion-reference-image", str(path.expanduser().resolve())]
            )
        for path in args.motion_reference_video:
            command.extend(
                ["--motion-reference-video", str(path.expanduser().resolve())]
            )
        if args.motion_lora is not None:
            command.extend(
                ["--motion-lora", str(args.motion_lora.expanduser().resolve())]
            )
        for enabled, flag in (
            (args.confirm_paid, "--confirm-paid"),
            (args.operator_selected, "--operator-selected"),
            (args.rights_confirmed, "--rights-confirmed"),
            (args.allow_upscale, "--allow-upscale"),
            (args.wait, "--wait"),
            (args.download, "--download"),
            (args.enable_prompt_expansion, "--enable-prompt-expansion"),
            (args.generate_audio, "--generate-audio"),
        ):
            if enabled:
                command.append(flag)
        return _run(command)
    if args.command in {"readiness", "review"}:
        if args.command == "readiness":
            print(
                "deprecated: use `creator-os review`; compatibility retained",
                file=sys.stderr,
            )
        command = _campaign_command("campaign-readiness", "--campaign", args.campaign)
        if args.user_id:
            command.extend(["--user-id", args.user_id])
        return _run(command)
    if args.command == "approve":
        command = _campaign_command(
            "creative-approval-build",
            "--campaign",
            args.campaign,
            "--rendered-asset-id",
            args.rendered_asset_id,
            "--user-id",
            args.user_id,
            "--approved-by",
            args.approved_by,
            "--surface",
            args.surface,
        )
        if args.publish_mode:
            command.extend(["--publish-mode", args.publish_mode])
        if args.root is not None:
            command.extend(["--root", str(args.root.expanduser().resolve())])
        return _run(command)
    if args.command in {"draft-export", "export"}:
        if args.command == "draft-export":
            print(
                "deprecated: use `creator-os export`; compatibility retained",
                file=sys.stderr,
            )
        if args.max_drafts <= 0:
            print("--max-drafts must be greater than zero", file=sys.stderr)
            return 2
        command = _campaign_command(
            "export-threadsdash",
            "--campaign",
            args.campaign,
            "--user-id",
            args.user_id,
            "--max-drafts",
            str(args.max_drafts),
            "--schedule-mode",
            "draft",
        )
        if args.dry_run:
            command.append("--dry-run")
        if args.review_only:
            command.append("--review-only")
        command.extend(["--surface", args.surface])
        for asset_id in args.rendered_asset_id:
            command.extend(["--rendered-asset-id", asset_id])
        return _run(command)
    if args.command == "advanced":
        advanced_args = args.args[1:] if args.args[:1] == ["--"] else args.args
        if args.surface == "models":
            return _run(_reel_command(*advanced_args))
        if args.surface == "prompt-expander":
            return _run(_prompt_expander_command(*advanced_args))
        if args.surface == "queue":
            return _run(_local_queue_command(*advanced_args))
        if args.surface == "benchmarks":
            return _run(_local_benchmark_command(*advanced_args))
        if args.surface == "arena":
            return _run(_local_arena_command(*advanced_args))
        if args.surface == "identity":
            return _run(_identity_command(*advanced_args))
        if args.surface == "router":
            return _run(_local_router_command(*advanced_args))
        if args.surface == "evidence-key":
            evidence_key = argparse.ArgumentParser(
                prog="creator-os advanced evidence-key"
            )
            evidence_key_subcommands = evidence_key.add_subparsers(
                dest="evidence_key_command", required=True
            )
            evidence_key_init = evidence_key_subcommands.add_parser("init")
            evidence_key_mode = evidence_key_init.add_mutually_exclusive_group(
                required=True
            )
            evidence_key_mode.add_argument("--dry-run", action="store_true")
            evidence_key_mode.add_argument("--apply", action="store_true")
            evidence_key_args = evidence_key.parse_args(advanced_args)
            return _run(
                _evidence_key_command(
                    "init", "--apply" if evidence_key_args.apply else "--dry-run"
                )
            )
        if args.surface == "approval-import":
            compatibility = argparse.ArgumentParser(
                prog="creator-os advanced approval-import"
            )
            compatibility.add_argument("--approval", type=Path, required=True)
            compatibility.add_argument("--root", type=Path)
            approval_args = compatibility.parse_args(advanced_args)
            command = _creative_approval_command(
                "--approval", str(approval_args.approval.expanduser().resolve())
            )
            if approval_args.root is not None:
                command.extend(
                    ["--root", str(approval_args.root.expanduser().resolve())]
                )
            return _run(command)
        if args.surface == "motion-qc-register":
            compatibility = argparse.ArgumentParser(
                prog="creator-os advanced motion-qc-register"
            )
            compatibility.add_argument("--rendered-asset-id", required=True)
            compatibility.add_argument("--receipt", type=Path, required=True)
            compatibility.add_argument("--operator")
            receipt_args = compatibility.parse_args(advanced_args)
            command = _campaign_command(
                "register-motion-qc-receipt",
                "--rendered-asset-id",
                receipt_args.rendered_asset_id,
                "--receipt",
                str(receipt_args.receipt.expanduser().resolve()),
            )
            if receipt_args.operator:
                command.extend(["--operator", receipt_args.operator])
            return _run(command)
        if args.surface == "analyzers":
            analyzers = argparse.ArgumentParser(
                prog="creator-os advanced analyzers",
                description="Emit the canonical ContentForge analyzer registry.",
            )
            analyzers.parse_args(advanced_args)
            request = json.dumps({"producedAt": datetime.now(UTC).isoformat()})
            return _run(
                [
                    "node",
                    str(ROOT / "packages/contentforge/cli.mjs"),
                    "analyzer-registry",
                ],
                cwd=ROOT,
                input_text=request,
            )
        raise AssertionError(f"unhandled advanced surface: {args.surface}")
    if args.command == "promote":
        command = _runtime_promotion_command(
            "--source-root",
            str(args.source_root.expanduser().resolve()),
            "--runtime-root",
            str(args.runtime_root.expanduser().resolve()),
            "--approved-commit",
            args.approved_commit,
            "--approval",
            str(args.approval.expanduser().resolve()),
            "--state-root",
            str(args.state_root.expanduser().resolve()),
            "--operator",
            args.operator,
        )
        if args.dry_run:
            command.append("--dry-run")
        return _run(command)
    raise AssertionError(f"unhandled command: {args.command}")


if __name__ == "__main__":
    raise SystemExit(main())
