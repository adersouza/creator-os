#!/usr/bin/env python3
"""Single operator-facing command for the headless Creator OS monorepo."""

from __future__ import annotations

import argparse
import json
import math
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def _run(command: list[str], *, cwd: Path = ROOT, input_text: str | None = None) -> int:
    return subprocess.run(
        command, cwd=cwd, check=False, input=input_text, text=input_text is not None
    ).returncode


def _doctor_command(*args: str) -> list[str]:
    """Run doctor through the exact project environment, not the launcher Python."""

    return [
        str(ROOT / ".venv" / "bin" / "python"),
        str(ROOT / "scripts" / "doctor.py"),
        *args,
    ]


def _campaign_command(*args: str) -> list[str]:
    return ["uv", "run", "--package", "campaign-factory", "campaign-factory", *args]


def _audio_command(*args: str) -> list[str]:
    return [
        "uv",
        "run",
        "--package",
        "campaign-factory",
        "python",
        "-m",
        "campaign_factory.audio_radar.cli",
        *args,
    ]


